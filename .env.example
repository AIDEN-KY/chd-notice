# 必填：DeepSeek 与 QQ 邮箱
DEEPSEEK_API_KEY=sk-your-key
# true：向 DeepSeek 提交非排除通知正文；false：不调用 AI，摘要降级为标题。
AI_SUMMARY_ENABLED=true
# 仅为关键词兜底，不代表自动识别所有敏感内容。命中标题/正文则不提交 AI。
AI_EXCLUDED_KEYWORDS=内部资料||禁止转发||保密||不得外传
QQ_EMAIL=your_account@qq.com
QQ_SMTP_AUTH_CODE=your_qq_smtp_authorization_code
MY_EMAIL=receiver@example.com

# 附件流式下载：只列已确认的学校附件主机，不填协议、路径或通配符。
ATTACHMENT_ALLOWED_HOSTS=portal.chd.edu.cn
MAX_SINGLE_ATTACHMENT_BYTES=20971520
# 保守的 MIME 邮件预算，不是 QQ SMTP 官方上限；原始附件总量仍限制为 20 MiB。
MAX_MESSAGE_BYTES=20971520

# 历史轮转与最新扫描共享 config.py 的总页数预算，每日仍只启动一次任务。
HISTORY_SCAN_ENABLED=true
HISTORY_PAGES_PER_RUN=2

# 可选：未来接入真实订阅系统后填写 HTTPS 退订页；留空则使用邮件退订链接。
# UNSUBSCRIBE_URL=https://example.com/unsubscribe

# 可选：学校页面 DOM 改版时覆盖。多个 CSS 选择器用 || 分隔。
# LIST_ITEM_SELECTORS=.bh-border-color-gray-5.bh-bg-color-light
# TITLE_SELECTORS=#readClass
# TIME_SELECTORS=.time_class
# DEPARTMENT_SELECTORS=.lmmc_class
# DETAIL_LINK_SELECTORS=a[href]
# DETAIL_CONTENT_SELECTORS=.ggnrclass
# ATTACHMENT_SELECTORS=.your-attachments a[href]
# NEXT_PAGE_SELECTORS=.your-next-button
# SCROLL_CONTAINER_SELECTORS=#app
